# ==========================================================================
# PUMP SCALPER PRO — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ==========================================================================

# --- Solana ---------------------------------------------------------------
# Any Solana JSON-RPC HTTP endpoint (mainnet-beta). Public endpoints are
# heavily rate-limited; a dedicated provider (Helius, QuickNode, Triton...)
# is strongly recommended for the scanner + execution engine.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket endpoint for logsSubscribe/accountSubscribe (usually the same
# host as SOLANA_RPC_URL with wss:// and no path change, but confirm with
# your RPC provider).
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Optional: DexScreener is used as a supplementary market-data source
# (liquidity/volume/buys/sells) for tokens the on-chain scanner discovers.
# It is a public API — no key required. Leave default unless self-hosting
# a proxy.
DEXSCREENER_API_BASE=https://api.dexscreener.com
# Jupiter's public swap aggregator — used for LIVE execution (manual trades
# only, signed by the user's own Phantom wallet). Verify this base URL
# against https://dev.jup.ag before relying on it; Jupiter has changed
# their public endpoint before.
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1

# --- Database / Cache -------------------------------------------------------
DATABASE_URL=postgres://pump_scalper:pump_scalper@localhost:5432/pump_scalper
REDIS_URL=redis://localhost:6379

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather and put the token here. Leave empty to disable
# Telegram integration entirely.
TELEGRAM_BOT_TOKEN=
# The chat id (your own user id, or a private group id) allowed to control
# the bot and receive alerts. Required if TELEGRAM_BOT_TOKEN is set.
TELEGRAM_CHAT_ID=

# --- Auth --------------------------------------------------------------------
# Random 32+ byte secret, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Optional: seed a single operator account on first boot (see README).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Live trading safety switch ---------------------------------------------
# MUST be explicitly set to true to allow ANY live (non-paper) transaction.
# Defaults to false everywhere: local dev, Docker, and production.
ENABLE_LIVE_TRADING=false

# --- Risk Engine (hard caps enforced server-side, independent of strategy) --
TRADING_ALLOCATION_SOL=0
MAX_POSITION_SIZE_SOL=0
MAX_DAILY_LOSS_SOL=0
MAX_TOTAL_EXPOSURE_SOL=0
MAX_OPEN_POSITIONS=0
MAX_TRADES_PER_DAY=0
MAX_SLIPPAGE_BPS=0
MIN_SOL_BALANCE=0

# --- Misc ---------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# --- Dashboard (apps/web) ------------------------------------------------------
# Where the browser reaches the API — must be reachable from the user's
# machine, not just the server (so NOT "localhost" in a VPS deployment).
NEXT_PUBLIC_API_URL=http://localhost:4000
# A Solana RPC endpoint the BROWSER calls directly (Phantom + wallet-adapter
# read the connected wallet's balance client-side). Can be the same
# provider as SOLANA_RPC_URL above, but public endpoints rate-limit by
# browser IP too — same recommendation to use a dedicated provider applies.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
